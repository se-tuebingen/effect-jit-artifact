{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Helium",
  "patterns": [
    { "include": "#comments" },
    { "include": "#bindings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#literals" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "block comment",
          "name": "comment.block.helium",
          "begin": "\\(\\*",
          "end": "\\*\\)"
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "match": "\\b(let|and)[[:space:]]+(?!data\\b(?!'))(rec[[:space:]]+)?(?!rec\\b(?!'))([[:lower:]_][[:word:]']*)[[:space:]]+(?!,|::)",
          "captures": {
            "1": { "name": "keyword.helium" },
            "2": { "name": "keyword.helium" },
            "3": { "name": "entity.name.function.binding.helium" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.helium",
          "match": "\\b(and|begin|data|effect|elif|else|end|export|extern|forall|fn|handle|handler|if|import|in|include|let|match|module|of|open|rec|sig|signature|struct|then|type|val|with|pragma|return|finally|resume|this|Effect|Sig|Type)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.helium",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.helium",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "comment": "character literal from escaped backslash",
          "name": "string.quoted.single.helium",
          "match": "'(\\\\\\\\)'",
          "captures": { "1": { "name": "constant.character.escape.helium" } }
        },
        {
          "comment": "character literal from escaped quote or whitespace",
          "name": "string.quoted.single.helium",
          "match": "'(\\\\[\"'ntbr ])'",
          "captures": { "1": { "name": "constant.character.escape.helium" } }
        },
        {
          "comment": "character literal from decimal ASCII code",
          "name": "string.quoted.single.helium",
          "match": "'(\\\\[[:digit:]]{3})'",
          "captures": { "1": { "name": "constant.character.escape.helium" } }
        },
        {
          "comment": "character literal from hexadecimal ASCII code",
          "name": "string.quoted.single.helium",
          "match": "'(\\\\x[[:xdigit:]]{2})'",
          "captures": { "1": { "name": "constant.character.escape.helium" } }
        },
        {
          "comment": "character literal from octal ASCII code",
          "name": "string.quoted.single.helium",
          "match": "'(\\\\o[0-3][0-7]{2})'",
          "captures": { "1": { "name": "constant.character.escape.helium" } }
        },
        {
          "comment": "character literal from unknown escape sequence",
          "name": "string.quoted.single.helium",
          "match": "'(\\\\.)'",
          "captures": {
            "1": { "name": "invalid.illegal.unknown-escape.helium" }
          }
        },
        {
          "comment": "character literal",
          "name": "string.quoted.single.helium",
          "match": "'.'"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "[;|,|=|<|>|\\||&|$|#|?|!|@|:|^|.|+|-|~|*|/|%]",
          "name": "keyword.operator.helium",
          "match": "([=<>|&$#?!@:^.+\\-~*/|%]+)"
        },
        {
          "comment": "type annotation",
          "name": "keyword.other.helium punctuation.other.colon punctuation.colon",
          "match": ":"
        },
        {
          "comment": "field accessor",
          "name": "keyword.other.helium punctuation.other.period punctuation.separator.period",
          "match": "\\."
        },
        {
          "comment": "semicolon separator",
          "name": "keyword.other.helium punctuation.separator.terminator punctuation.separator.semicolon",
          "match": ";"
        },
        {
          "comment": "comma separator",
          "name": "keyword.other.helium punctuation.comma punctuation.separator.comma",
          "match": ","
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "wildcard underscore",
          "name": "constant.language.helium",
          "match": "\\b_\\b"
        },
        {
          "comment": "capital identifier",
          "name": "constant.language.capital-identifier.helium",
          "match": "\\b[[:upper:]][[:word:]']*('|\\b)"
        },
        {
          "comment": "lowercase identifier",
          "name": "source.helium",
          "match": "\\b[[:lower:]_][[:word:]']*('|\\b)"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "comment": "boolean literal",
          "name": "constant.language.boolean.helium",
          "match": "\\b(true|false)\\b"
        },

        {
          "comment": "decimal integer literal",
          "name": "constant.numeric.decimal.integer.helium",
          "match": "\\b([[:digit:]][[:digit:]_]*[lLng-zG-Z]?)\\b"
        },
        {
          "comment": "hexadecimal integer literal",
          "name": "constant.numeric.hexadecimal.integer.helium",
          "match": "\\b((0x|0X)[[:xdigit:]][[:xdigit:]_]*[lLng-zG-Z]?)\\b"
        },
        {
          "comment": "octal integer literal",
          "name": "constant.numeric.octal.integer.helium",
          "match": "\\b((0o|0O)[0-7][0-7_]*[lLng-zG-Z]?)\\b"
        },

        {
          "comment": "binary integer literal",
          "name": "constant.numeric.binary.integer.helium",
          "match": "\\b((0b|0B)[0-1][0-1_]*[lLng-zG-Z]?)\\b"
        },

        {
          "comment": "unit literal",
          "name": "constant.language.unit.helium",
          "match": "\\(\\)"
        },
        {
          "comment": "parentheses",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [{ "include": "$self" }]
        },

        {
          "comment": "empty list",
          "name": "constant.language.list.helium",
          "match": "\\[\\]"
        },
        {
          "comment": "list",
          "begin": "\\[",
          "end": "]",
          "patterns": [{ "include": "$self" }]
        },
        {
          "comment": "braces",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "$self" }]
        }
      ]
    }
  },
  "scopeName": "source.helium"
}
