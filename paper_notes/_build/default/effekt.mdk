<!-- Configure replacements in math, see math.mdk -->
.replacements {

  replace: "//@->/\looparrowright\
            //<-@/\looparrowleft\
            //there/1\
            //=>/\Rightarrow{}\
            //here/0\
            //dom/\mathrm{dom}\
            //gm";

  constants: "true|false";

  keywords: "def|val|return|try|with|finally|resume|on|suspend|cap|push|primitive|shift|if|then|else|jump|stack|new|match|drop|reset|Evi|Stack|&constants;";

