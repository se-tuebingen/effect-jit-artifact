  runtime-prompts: "//\s#/~{\\#}\
                    //_#/_{\\#}\
                    //^#/{\\#}\
                    //\(#/{(\\#}";

  other-replacements: "&runtime-prompts;&nonterminals;&judgements;&statemachines;";
}

