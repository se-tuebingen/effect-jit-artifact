[INCLUDE=styles/acmart]
[INCLUDE=styles/common]
[INCLUDE=styles/colors]
[INCLUDE=styles/todos]
[INCLUDE=styles/math]

Prelude : plaintex

Acm Format  : acmsmall,screen,10pt
Bibliography: bibliography.bib
Bibliography: additional.bib

<!-- For tables -->
Package         : booktabs
Package         : [bb=boondox]mathalfa
Package         : threeparttable
Package         : tikz

Colorizer       : effekt

<!-- languages -->
@tex lang       : $\mathsf{Effekt}$
@tex core       : $\mathsf{System}\;\mathcal{C}$
@tex oldcore       : $\mathsf{System}\;\Xi$
@tex sysf       : $\mathsf{System}\;\mathsf{F}$
@tex fsub       : $\mathsf{System}\;\mathsf{F}_{lt:}$
@tex tunnel     : $\lambdadownup$
@tex lambda12   : $\lambda^{1/2}$

@tex highlightstart : [\highlightsmall{]{.texraw}
@tex highlightend : [}]{.texraw}
@tex codeellipsis : $\ldots$

.labelcol { width: 22% }
.vcol { width: 2%; }
.defcol { width: 45% }

.code1, .pre-indented, .pre-fenced3 {
  language: effekt;
  .code-replacements;
}

.codesub {
  tex-cmd: "\textsubscript"
}

exists : [$\exists$]{.texraw}

.code-replacements {
  replace: "//\(\|(\d+)\|\)/\((\1)|[\1]{.code-index}\)\
            //=>/\(=>|[&rArr;]{.serif}\)\
            //->/\(->|[&rarr;]{.serif}\)\
            //~>/\(xx|$\rightsquigarrow$\)\
            //>>>/\(xx|&highlightstart;\)\
            //\bexists\b/\(=>|&exists;\)\
            //>=/\(>=|&ge;\)\
            //>=/\(>=|&ge;\)\
            //<=/\(<=|&le;\)\
            //_s\b/\(x|~[s]{.codesub}~\)\
            //\btau\b/\(t|[&tau;]{.serif}\)\
            //([a-zA-Z_-]+)(\d+)\b/\1\(\1|~[\2]{.codesub}~\)\
            //\.\.\./\(...|&codeellipsis;\)\
            //gm";
}

<!-- Configure replacements in math, see math.mdk -->
.replacements {

  replace: "//@->/\looparrowright\
            //<-@/\looparrowleft\
            //there/1\
            //=>/\Rightarrow{}\
            //here/0\
            //dom/\mathrm{dom}\
            //gm";

  constants: "true|false";

  keywords: "def|val|return|try|with|finally|resume|on|suspend|cap|push|primitive|shift|if|then|else|jump|stack|new|match|drop|reset|Evi|Stack|let|letrec|in|construct|project|invoke|letref|at|load|store|fresh|label|control|resumed|&constants;";

  nonterminals: "//\bstmt(?![a-zA-Z])/s\
                 //\bprogram(?![a-zA-Z])/P\
                 //\bfn(?![a-zA-Z])/\lambda\
                 //\bdefi(?![a-zA-Z])/D\
                 //\bterm(?![a-zA-Z])/t";

  judgements: "//\s::(?!\S)/\;\;\mathrel{\metameta{:}}\
               //<:/\mathrel{<:}\
               //\s\/\/(?!\S)/\;\mathrel{\metameta{\vertrule}}";

  statemachines: "//</\mathrel{\metameta{\langle}}\
                  //>/\mathrel{\metameta{\rangle}}\
                  //•/\cdot{}";

  runtime-prompts: "//\s#/~{\\#}\
                    //_#/_{\\#}\
                    //^#/{\\#}\
                    //\(#/{(\\#}";

  other-replacements: "&runtime-prompts;&nonterminals;&judgements;&statemachines;";
}

@tex .todo-style {
  %display : none;
}

.tr { display: none; }

Notes {
  display: none;
}

strong {
  font-family: sans-serif;
}

.indent {
  tex-env-outer: codeintext;
}

.kk {
  language: kokax;
  replace:"/^:/\(:|\)/";
}

.math-inline {
  input: mathpre;
}

.small {
  font-size: small;
}

@tex pre {
  font-size:small;
}

.sf {
  font-family: sans-serif;
  font-weight: bold;
}

.token.comment.doc {
  font-size: smaller;
  //tex-cmd-before: "\fbox{\ \strut ";
  //tex-cmd-after: "\ }";
}

@if TeX {
  pre { tex-cmd-outer:"{\def~{\nobreakspace{}}"; }
}

DefinitionList {
  tex-env-outer: "definitionlist";
}

Tex Header:
  \newenvironment{definitionlist}%
    {\begin{minipage}[t]{\linewidth}\vspace{-0.4em}}%
    {\end{minipage}\vspace{0.6em}}

~TexRaw
\author{Marcial Gaißert}%
\affiliation{%
  \institution{University of Tübingen}
  \country{Germany}
}
\authorsaddresses{}
\def\shortauthors{Gaißert}
\def\shorttitle{}
~

