Package: drawstack
Package: tikz
Package: pgf
Package: tikz-cd

Tex Header:
  \usetikzlibrary{tikzmark}
  \usetikzlibrary{%
    arrows,%
    arrows.meta,%
    automata,
    shapes.misc,%
    shapes.arrows,%
    chains,%
    matrix,%
    patterns,%
    positioning,%
    scopes,%
    calc,% for relative positions
    decorations.pathmorphing,%
    decorations.pathreplacing,% for braces
    shadows%
  }
  \tikzstyle{freecell}=[fill=black!5,draw=black]
  \tikzstyle{occupiedcell}=[fill=black!15,draw=black]
  \tikzstyle{padding}=[pattern=north west lines, pattern color=black!20,draw=black]
  \tikzstyle{highlight}=[draw=orange!50!black,text=orange!50!black]
