Tex Header:
  \usepackage{color}
  \usepackage{xcolor}
  %
  % --- Tuebingen Colors ---
  % Primary
  \definecolor{tu-red}{RGB}{165, 30, 55}
  \definecolor{tu-gold}{RGB}{180, 160, 105}
  \definecolor{tu-gray}{RGB}{50, 65, 75}
  %
  % Secondary
  % https://uni-tuebingen.de/einrichtungen/verwaltung/stabsstellen/hochschulkommunikation/service-fuer-beschaeftigte/corporate-design/basiselemente/farben/sekundaerfarben/
  \definecolor{tu-lavendar}{RGB}{65, 90, 140}
  \definecolor{tu-blue}{RGB}{0, 105, 170}
  \definecolor{tu-lightblue}{RGB}{80, 170, 200}
  \definecolor{tu-turkis}{RGB}{130, 185, 160}
  %
  \definecolor{tu-lightgreen}{RGB}{125, 165, 75}
  \definecolor{tu-green}{RGB}{50, 110, 30}
  \definecolor{tu-orange}{RGB}{200, 80, 60}
  \definecolor{tu-violet}{RGB}{175, 110, 150}
  %
  \definecolor{tu-taupe}{RGB}{180, 160, 150}
  \definecolor{tu-mustard}{RGB}{215, 180, 105}
  \definecolor{tu-yellow}{RGB}{210, 150, 0}
  \definecolor{tu-brown}{RGB}{145, 105, 70}
  %
  % Derived Colors
  %
  \colorlet{light-gray}{tu-gray!15!white}
  \colorlet{dark-gray}{tu-gray!30!white}
  %
  \colorlet{ACMBlue}{tu-lightblue}
  %
  % --- Syntax Highlighting Colors ---
  \definecolor{entrypoint-color}{RGB}{244, 226, 188}
  \colorlet{token-gray}{tu-gray}
  \colorlet{string-color}{maroon}
  \colorlet{number-color}{tu-blue}
  \colorlet{comment-color}{tu-taupe}
  %
  % Safe Colors
  \definecolor{coeffect-blue-bg}{RGB}{233, 239, 243}
  \definecolor{coeffect-blue}{RGB}{45, 95, 134}
  \definecolor{judgement}{RGB}{170, 170, 170}


