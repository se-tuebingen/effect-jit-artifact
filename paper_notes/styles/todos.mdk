.todo-style {
  border-left: 3pt solid gray;
  padding-left: 1em;
  font-size: 8pt;
}

@tex .todo-style {
  xdisplay : none;
}

todo { .todo-style }

jonathan {
  .todo-style
  before: "**Jonathan**. ";
  border-left: 3pt solid green;
}

.philipp {
  .todo-style
  before: "**Philipp**. ";
}

philipp {
  .philipp
  border-left: 3pt solid purple;
}

.alex {
  .todo-style
  before: "**Alex**. ";
}

alex {
  .klaus
  border-left: 3pt solid red;
}

hide {
  display: none
}
